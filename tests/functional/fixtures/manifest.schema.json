{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceApproval", "audioFormat", "fixtures", "scenarios"],
  "properties": {
    "sourceApproval": { "type": "string", "minLength": 1 },
    "audioFormat": {
      "const": { "encoding": "pcm_s16le", "sampleRateHz": 16000, "bitsPerSample": 16, "channels": 1 }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "locale", "continuousContent", "audioEndFrame"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?-[A-Z]{2}$|^[a-z]{2,3}-[A-Z]{2}$" },
          "continuousContent": { "type": "boolean" },
          "silenceIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["startFrame", "endFrame"],
              "properties": {
                "startFrame": { "type": "integer", "minimum": 0 },
                "endFrame": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "audioEndFrame": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["IQA-001", "IQA-002", "IQA-003"],
      "properties": {
        "IQA-001": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "IQA-002": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "IQA-003": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
