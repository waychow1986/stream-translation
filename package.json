{
  "name": "stream-translation",
  "version": "1.0.0",
  "description": "AIDelivery Hub generated application: 企业实时翻译",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "clean": "node --eval \"import { rmSync } from \\\"node:fs\\\"; rmSync(\\\"dist\\\", { recursive: true, force: true });\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "staticAnalysis": "npm run typecheck && npm run lint",
    "build:client": "vite build --outDir dist/client",
    "build:server": "tsc --noEmit && vite build --ssr src/server/index.ts --outDir dist/server",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:functional": "playwright test tests/functional/*.spec.ts tests/functional/remote/*.spec.ts --pass-with-no-tests"
  },
  "license": "ISC",
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
